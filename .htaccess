# Le site compile vit dans /dist — on sert ce dossier sans qu'il apparaisse dans l'URL
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si la requete cible un fichier reel dans dist/ (assets, images, favicon...)
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Sinon, router toutes les pages vers dist/ (index.html, 404.html, sitemap...)
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

ErrorDocument 404 /dist/404.html