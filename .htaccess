# Routage : sert le site compile depuis /dist sans montrer /dist dans l'URL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Racine -> index
  RewriteRule ^$ dist/index.html [L]

  # Fichiers reels dans dist/ (assets, images, favicon, sitemap...)
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

# Page 404 personnalisee
ErrorDocument 404 /dist/404.html