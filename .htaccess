# MODE CONSTRUCTION : tout le monde voit construction.html
# Pour publier le vrai site : supprimer la section MODE CONSTRUCTION ci-dessous
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Les assets du vrai site restent accessibles (pour tester en direct)
  RewriteCond %{REQUEST_URI} ^/_astro/ [OR]
  RewriteCond %{REQUEST_URI} ^/ai/ [OR]
  RewriteCond %{REQUEST_URI} ^/(favicon|logo)\.svg$
  RewriteRule ^(.*)$ dist/$1 [L]

  # Tout le reste -> page construction
  RewriteRule ^(.*)$ dist/construction/index.html [L]
</IfModule>

