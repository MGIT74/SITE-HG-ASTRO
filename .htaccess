# Routage : sert le site compile depuis /dist sans montrer /dist dans l'URL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Autoriser l'acces direct aux fichiers du repo utiles (htaccess lui-meme)
  # Tout le reste est sert depuis dist/

  # 1. Fichiers reels presents dans dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist%{REQUEST_URI} [L]

  # 2. Repertoires (ex: /_astro/, /ai/)
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -d
  RewriteRule ^(.*)$ dist%{REQUEST_URI} [L]

  # 3. Tout le reste -> index.html (SPA / pages Astro)
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# Page 404 personnalisee
ErrorDocument 404 /dist/404.html