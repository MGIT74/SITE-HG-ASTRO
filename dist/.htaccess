# MODE CONSTRUCTION : les visiteurs voient la page "en construction" partout.
# Pour publier le vrai site : commenter ce bloc, et decommenter le bloc PUBLICATION plus bas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Assets du site reel servis directement depuis dist/ (pour la page de construction et tests)
  RewriteCond %{REQUEST_URI} /_astro/ [OR]
  RewriteCond %{REQUEST_URI} /ai/ [OR]
  RewriteCond %{REQUEST_URI} favicon\.svg [OR]
  RewriteCond %{REQUEST_URI} logo\.svg [OR]
  RewriteCond %{REQUEST_URI} robots\.txt
  RewriteRule ^(.*)$ dist/$1 [L]

  # Tout le reste (y compris la racine) -> page construction.
  # Garde anti-boucle : jamais re-rewriter ce qui est deja dans /dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^(.*)$ dist/construction/index.html [L]
</IfModule>

# ===== PUBLICATION (au lancement : commenter le bloc CONSTRUCTION au-dessus, decommenter celui-ci)
