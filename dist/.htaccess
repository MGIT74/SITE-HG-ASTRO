# MODE CONSTRUCTION : les visiteurs voient la page "en construction" partout.
# Pour publier le vrai site : commenter ce bloc, et decommenter le bloc PUBLICATION plus bas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Toutes les URLs passent par construction/, sauf les assets servis par le bloc PUBLIGATION ci-dessous si actif.
  # Garde: ne pas re-rewriter ce qui est deja dans /dist/ (sinon boucle 500)

  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_URI} !(favicon|logo)\.svg$
  RewriteCond %{REQUEST_URI} !^/(ai|_astro)/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ dist/construction/index.html [L]

  # assets svg + ai/ servis depuis dist/
  RewriteCond %{REQUEST_URI} ^/(ai|_astro)/ [OR]
  RewriteCond %{REQUEST_URI} (favicon|logo)\.svg$
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

# ===== PUBLICATION (au lancement : commenter le bloc CONSTRUCTION au-dessus, decommenter celui-ci)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   RewriteRule ^/?$ dist/index.html [L]
#   RewriteCond %{REQUEST_URI} !^/dist/
#   RewriteCond %{REQUEST_URI} !^/(_astro|ai)/
#   RewriteCond %{REQUEST_URI} !(favicon|logo)\.svg$
#   RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
#   RewriteRule ^(.*)$ dist/$1 [L]
# </IfModule>
# ErrorDocument 404 /dist/404.html

ErrorDocument 404 /dist/construction/index.html