<!DOCTYPE html>
<html lang="fr" class="construction">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hands Graphic — Bientôt en ligne</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Le nouveau site de Hands Graphic arrive bientôt." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="wrap">
      <div class="card">
        <div class="badge">
          <span class="badge-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="7" width="14" height="12" rx="3"></rect><path d="M12 7V4"></path><circle cx="12" cy="3" r="1"></circle><circle cx="9.5" cy="13" r="1" fill="currentColor" stroke="none"></circle><circle cx="14.5" cy="13" r="1" fill="currentColor" stroke="none"></circle></svg>
          </span>
          Notre agent IA prépare quelque chose...
        </div>

        <div class="logo-block">
          <div class="logo-box">
            <img src="/logo.svg" alt="Logo Hands Graphic" class="logo-img" />
          </div>
          <h1 class="title">Site en construction</h1>
          <p class="sub">Les travaux avancent bien — revenez très vite.</p>
        </div>

        <div class="progress" role="progressbar" aria-label="Avancement des travaux" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100">
          <div class="bar"><div class="fill" id="fill"></div></div>
          <div class="meta">
            <span id="step">Polissage du design…</span>
            <strong><span id="pct">0</span>%</strong>
          </div>
        </div>

        <a class="btn" href="mailto:contact@handsgraphic.com">
          Nous contacter
          <span>→</span>
        </a>
      </div>
    </main>

    <script>
      const fill = document.getElementById('fill');
      const pct = document.getElementById('pct');
      const step = document.getElementById('step');

      const labels = [
        [15, 'Préparation des agents IA…'],
        [36, 'Configuration des automatisations…'],
        [58, 'Optimisation des pages…'],
        [72, 'Polissage du design…'],
      ];
      const labelFor = (v) => labels.filter(([t]) => v >= t).at(-1)?.[1] ?? labels[0][1];

      const target = 72;
      let v = 0;
      function run() {
        v = Math.min(v + Math.random() * (v < 58 ? 2.4 : 1.2), target);
        fill.style.width = v + '%';
        pct.textContent = Math.round(v);
        step.textContent = labelFor(v);
        if (v < target) {
          setTimeout(run, 200 + Math.random() * 500);
        } else {
          setInterval(() => {
            const wobble = 72 + (Math.random() - 0.5) * 0.6;
            fill.style.width = wobble + '%';
            pct.textContent = Math.round(wobble);
          }, 2200);
        }
      }
      setTimeout(run, 500);
    </script>

    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body { height: 100%; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #1d1d1f;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        -webkit-font-smoothing: antialiased;
      }

      .wrap { position: relative; z-index: 1; }

      .card {
        max-width: 560px;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 28px;
        padding: 3.5rem 3rem 2.5rem;
        text-align: center;
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.08);
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.07);
        padding: 0.55rem 1.1rem;
        border-radius: 40px;
        font-size: 0.84rem;
        font-weight: 600;
        color: #6e6e73;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
      }

      .badge-icon {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: linear-gradient(135deg, #5ea2ff, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(59, 130, 246, 0.4);
        animation: tilt 3s ease-in-out infinite;
      }

      @keyframes tilt {
        0%, 100% { transform: rotate(-6deg); }
        50% { transform: rotate(6deg); }
      }

      .logo-block { margin-top: 2.5rem; }

      .logo-box {
        width: 110px;
        height: 110px;
        border-radius: 28px;
        background: #1d1d1f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
      }

      .logo-img {
        width: 58%;
        height: 58%;
        object-fit: contain;
      }

      .title {
        font-size: clamp(1.6rem, 5vw, 2.6rem);
        font-weight: 800;
        letter-spacing: -1px;
        margin-top: 1.25rem;
        color: #1d1d1f;
      }

      .sub {
        color: #6e6e73;
        line-height: 1.7;
        margin: 12px 0 0;
        font-size: 0.98rem;
      }

      .progress { margin-top: 2.5rem; text-align: left; }

      .bar {
        height: 8px;
        border-radius: 99px;
        background: rgba(0, 0, 0, 0.08);
        overflow: hidden;
      }

      .fill {
        width: 0;
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, #5ea2ff, #2563eb);
        transition: width 0.4s ease;
      }

      .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.6rem;
        font-size: 0.82rem;
        color: #6e6e73;
      }

      .meta strong { color: #1d1d1f; font-variant-numeric: tabular-nums; }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2.25rem;
        background: #1d1d1f;
        color: white;
        padding: 12px 26px;
        border-radius: 40px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .btn:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(0, 0, 0, 0.3); }

      @media (max-width: 480px) {
        .card { padding: 2.25rem 1.5rem 1.75rem; }
      }
    </style>
  </body>
</html>