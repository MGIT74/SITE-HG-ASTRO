---
import { heroStats } from '../data/site.js';
---

<section class="hero" id="home">
  <div class="hero-badge" data-reveal="fade">
    <span class="dot"></span>
    Expert IA et Consultant Marketing Digital
  </div>

  <h1 class="hero-title" data-reveal="fade" style="--reveal-delay:100ms">
    <span class="title-line-1"><span>Automatisez<span class="title-icon title-icon-robot" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="3"></rect><path d="M12 8V4"></path><circle cx="12" cy="3" r="1"></circle><circle cx="9" cy="14" r="1" fill="currentColor" stroke="none"></circle><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none"></circle></svg></span> Votre Entreprise</span> <span>et Multipliez</span></span><br />
    <span class="highlight">Vos Clients<span class="title-icon title-icon-clients" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c0-3.6 2.9-5.5 6.5-5.5s6.5 1.9 6.5 5.5"></path><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8"></path><path d="M17.5 14.9c2.4.7 4 2.3 4 5.1"></path></svg></span></span>
  </h1>

  <p class="hero-subtitle" data-reveal="fade" style="--reveal-delay:200ms">
    Agents IA, applications métier et marketing automatisé pour faire croître votre entreprise 24/7.
  </p>

  <a href="#contact" class="btn-hero" data-chat="generic" data-reveal="fade" style="--reveal-delay:300ms">Réserver un Audit Gratuit →</a>

  <div class="hero-stats-bar" data-reveal="fade" style="--reveal-delay:400ms">
    {heroStats.map((stat) => (
      <div class="stat-bar-item">
        <span class="stat-bar-value" data-countup={stat.value}>{stat.value}</span>
        <span class="stat-bar-label">{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 11rem 5% 4rem;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    padding: 0.55rem 1.1rem;
    border-radius: 50px;
    font-size: 0.78rem;
    color: var(--ink-secondary);
    margin-bottom: 2rem;
    font-weight: 500;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }

  .hero-badge .dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1.08;
    margin-bottom: 1rem;
    letter-spacing: -2.5px;
    max-width: 1000px;
  }

  .hero-title .highlight {
    background: linear-gradient(90deg, #3a3a3c 0%, #1d1d1f 40%, #6e6e73 60%, #3a3a3c 100%);
    background-size: 250% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: text-shine 8s linear infinite;
  }

  .title-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.72em;
    height: 0.72em;
    border-radius: 0.22em;
    margin-left: 0.14em;
    vertical-align: baseline;
    transform: translateY(-0.08em);
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.04),
      0 2px 6px rgba(0, 0, 0, 0.12);
  }

  .title-icon svg {
    width: 62%;
    height: 62%;
  }

  .title-icon-robot {
    background: linear-gradient(135deg, #3a3a3c, #1d1d1f);
    color: white;
  }

  .title-icon-clients {
    background: linear-gradient(135deg, #3a3a3c, #1d1d1f);
    color: white;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--ink-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 2.5rem;
  }

  .btn-hero {
    background: var(--ink);
    color: white;
    padding: 1rem 2.4rem;
    border-radius: 50px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.3s var(--ease-spring);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 4rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .btn-hero:hover {
    background: #000;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }

  .hero-stats-bar {
    display: flex;
    gap: 3.5rem;
    justify-content: center;
    flex-wrap: wrap;
    padding: 2.25rem 3rem;
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.03),
      0 8px 32px rgba(0, 0, 0, 0.04);
  }

  .stat-bar-item {
    text-align: center;
  }

  .stat-bar-value {
    display: block;
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -1px;
    background: linear-gradient(135deg, #3a3a3c, #1d1d1f);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.35rem;
  }

  .stat-bar-label {
    font-size: 0.88rem;
    color: var(--ink-tertiary);
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.4rem; letter-spacing: -1px; }
    .hero-stats-bar { gap: 1.5rem; padding: 1.75rem 1.5rem; }
    .stat-bar-value { font-size: 1.9rem; }

    .hero-title .title-line-1 {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.05em;
    }

    .hero-title { margin-bottom: 0.75rem; }
  }
</style>

<script>
  function parseStat(value) {

    const match = value.match(/^([^\d]*)([\d.]+)(.*)$/);
    if (!match) return null;
    return { prefix: match[1], num: parseFloat(match[2]), decimals: (match[2].split('.')[1] || '').length, suffix: match[3] };
  }

  function easeOutQuart(t) {
    return 1 - Math.pow(1 - t, 4);
  }

  function animateCount(el, target, duration) {
    const parsed = parseStat(target);
    if (!parsed) return;

    const start = performance.now();

    function frame(now) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = easeOutQuart(progress);
      const current = parsed.num * eased;


      const formatted = parsed.decimals > 0
        ? current.toFixed(parsed.decimals)
        : Math.round(current).toString();

      el.textContent = parsed.prefix + formatted + parsed.suffix;

      if (progress < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  const statValues = document.querySelectorAll('[data-countup]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced && 'IntersectionObserver' in window) {
    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target;
          animateCount(el, el.getAttribute('data-countup'), 1200);
          statsObserver.unobserve(el);
        }
      });
    }, { threshold: 0.4 });

    statValues.forEach((el) => statsObserver.observe(el));
  }
</script>