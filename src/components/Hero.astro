---
import { heroStats } from '../data/site.js';
---

<section class="hero" id="home">
  <div class="hero-badge" data-reveal="fade">
    <span class="dot"></span>
    Expert IA et Consultant Marketing Digital
  </div>

  <h1 class="hero-title" data-reveal="fade" style="--reveal-delay:100ms">
    <span class="title-line-1"><span>Automatisez Votre <span class="word-rotator"><span class="word-rotator-word" id="rotating-word">Entreprise</span></span></span> <span>et Multipliez</span></span><br />
    <span class="highlight">Vos Clients Même Quand Vous Dormez</span>
  </h1>

  <p class="hero-subtitle" data-reveal="fade" style="--reveal-delay:200ms">
    Agence spécialisée en automatisation IA et marketing digital. Nous créons des agents intelligents, des applications métier et des campagnes marketing automatisées pour faire croître votre entreprise 24/7.
  </p>

  <a href="#contact" class="btn-hero" data-chat="generic" data-reveal="fade" style="--reveal-delay:300ms">Réserver un Audit Gratuit →</a>

  <div class="hero-stats-bar" data-reveal="fade" style="--reveal-delay:400ms">
    {heroStats.map((stat) => (
      <div class="stat-bar-item">
        <span class="stat-bar-value" data-countup={stat.value}>{stat.value}</span>
        <span class="stat-bar-label">{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 11rem 5% 4rem;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    padding: 0.55rem 1.1rem;
    border-radius: 50px;
    font-size: 0.78rem;
    color: var(--ink-secondary);
    margin-bottom: 2rem;
    font-weight: 500;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }

  .hero-badge .dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1.08;
    margin-bottom: 1rem;
    letter-spacing: -2.5px;
    max-width: 1000px;
  }

  .hero-title .highlight {
    background: linear-gradient(90deg, #0a84ff 0%, #0071e3 40%, #409cff 60%, #0a84ff 100%);
    background-size: 250% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: text-shine 8s linear infinite;
  }

  .word-rotator {
    display: inline-flex;
    justify-content: center;
    vertical-align: bottom;
    white-space: nowrap;
    transition: width 0.5s var(--ease-smooth);
    will-change: width;
  }

  .word-rotator-word {
    display: inline-block;
    color: var(--ink);
  }

  .word-rotator-word.slide-out {
    animation: word-out 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  .word-rotator-word.slide-in {
    animation: word-in 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes word-out {
    to {
      opacity: 0;
      transform: translateY(-0.45em) rotateX(40deg);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.45em) rotateX(-40deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotateX(0);
    }
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--ink-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 2.5rem;
  }

  .btn-hero {
    background: var(--ink);
    color: white;
    padding: 1rem 2.4rem;
    border-radius: 50px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.3s var(--ease-spring);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 4rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .btn-hero:hover {
    background: #000;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }

  .hero-stats-bar {
    display: flex;
    gap: 3.5rem;
    justify-content: center;
    flex-wrap: wrap;
    padding: 2.25rem 3rem;
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.03),
      0 8px 32px rgba(0, 0, 0, 0.04);
  }

  .stat-bar-item {
    text-align: center;
  }

  .stat-bar-value {
    display: block;
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -1px;
    background: linear-gradient(135deg, #0a84ff, #0071e3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.35rem;
  }

  .stat-bar-label {
    font-size: 0.88rem;
    color: var(--ink-tertiary);
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.4rem; letter-spacing: -1px; }
    .hero-stats-bar { gap: 1.5rem; padding: 1.75rem 1.5rem; }
    .stat-bar-value { font-size: 1.9rem; }

    .hero-title .title-line-1 {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.05em;
    }

    .hero-title { margin-bottom: 0.75rem; }
  }
</style>

<script>
  const rotatingWords = ['Entreprise', 'SaaS', 'MVP', 'Site'];
  const wordEl = document.getElementById('rotating-word');
  const rotatorBox = wordEl?.closest('.word-rotator');
  let wordIndex = 0;

  if (wordEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {

    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;';
    wordEl.parentElement?.appendChild(probe);
    const widths = rotatingWords.map((w) => {
      probe.textContent = w;
      const style = getComputedStyle(wordEl);
      probe.style.font = style.font;
      return probe.offsetWidth;
    });
    probe.remove();


    function setWidth(wordIdx) {
      if (rotatorBox) rotatorBox.style.width = widths[wordIdx] + 'px';
    }
    setWidth(0);

    setInterval(() => {
      wordEl.classList.add('slide-out');

      setTimeout(() => {
        wordIndex = (wordIndex + 1) % rotatingWords.length;
        wordEl.textContent = rotatingWords[wordIndex];
        setWidth(wordIndex);
        wordEl.classList.remove('slide-out');
        wordEl.classList.add('slide-in');

        setTimeout(() => wordEl.classList.remove('slide-in'), 450);
      }, 400);
    }, 2800);
  }


  function parseStat(value) {

    const match = value.match(/^([^\d]*)([\d.]+)(.*)$/);
    if (!match) return null;
    return { prefix: match[1], num: parseFloat(match[2]), decimals: (match[2].split('.')[1] || '').length, suffix: match[3] };
  }

  function easeOutQuart(t) {
    return 1 - Math.pow(1 - t, 4);
  }

  function animateCount(el, target, duration) {
    const parsed = parseStat(target);
    if (!parsed) return;

    const start = performance.now();

    function frame(now) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = easeOutQuart(progress);
      const current = parsed.num * eased;


      const formatted = parsed.decimals > 0
        ? current.toFixed(parsed.decimals)
        : Math.round(current).toString();

      el.textContent = parsed.prefix + formatted + parsed.suffix;

      if (progress < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  const statValues = document.querySelectorAll('[data-countup]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced && 'IntersectionObserver' in window) {
    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target;
          animateCount(el, el.getAttribute('data-countup'), 1200);
          statsObserver.unobserve(el);
        }
      });
    }, { threshold: 0.4 });

    statValues.forEach((el) => statsObserver.observe(el));
  }
</script>