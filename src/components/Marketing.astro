---
import { marketingItems, marketingStats } from '../data/site.js';

const icons = [
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="0.5" fill="currentColor"></circle></svg>',
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>',
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="5" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="M8.3 10.8l7.4-4.6"></path><path d="M8.3 13.2l7.4 4.6"></path></svg>',
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>',
];
---

<section class="marketing" id="marketing">
  <div class="marketing-container">
    <div class="marketing-content" data-reveal="fade">
      <div class="marketing-badge">NOUVEAU</div>
      <h2>Marketing Digital + Automatisation = <span class="highlight">Croissance Illimitée</span></h2>
      <p class="marketing-text">
        Ne vous contentez pas d'automatiser l'existant. Utilisez le marketing digital automatisé pour <strong>attirer continuellement de nouveaux clients</strong>, même pendant que vous dormez.
      </p>
      <div class="marketing-grid">
        {marketingItems.map((item, index) => (
          <div class="marketing-item" data-reveal="fade" style={`--reveal-delay:${index * 80}ms`}>
            <div class="marketing-item-icon" set:html={icons[index]} />
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
      <a href="#contact" class="btn-marketing" data-chat="marketing">Découvrir le Marketing Automatisé →</a>
    </div>

    <div class="marketing-visual" data-reveal="scale" style="--reveal-delay:150ms">
      <div class="workflow-graph">
        <svg class="workflow-edges" viewBox="0 0 520 420" fill="none" aria-hidden="true">
          <path class="wf-edge" d="M100 50 V 40 Q 100 28 112 28 H 408 Q 420 28 420 40 V 50"></path>
          <path class="wf-edge" d="M100 106 V 210"></path>
          <path class="wf-edge" d="M420 106 V 210"></path>
          <path class="wf-edge" d="M270 84 V 170"></path>
          <path class="wf-edge" d="M260 210 V 306 Q 260 318 272 318 H 284"></path>
          <circle class="wf-pulse p1" r="4.5"></circle>
          <circle class="wf-pulse p2" r="4.5"></circle>
          <circle class="wf-pulse p3" r="4.5"></circle>
          <circle class="wf-pulse p4" r="4.5"></circle>
        </svg>

        <div class="wf-card" style="left:24px; top:50px; --tint:#f59e0b;">
          <div class="wf-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          </div>
          <div class="wf-lines"><span class="wf-line l1"></span><span class="wf-line l2"></span></div>
        </div>

        <div class="wf-card hi" style="left:194px; top:2px; --tint:#ec4899;">
          <div class="wf-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.8L20 12l-6.1 3.2L12 21l-1.9-5.8L4 12l6.1-3.2z"></path></svg>
          </div>
          <div class="wf-lines"><span class="wf-line l1"></span><span class="wf-line l2"></span></div>
        </div>

        <div class="wf-card" style="left:364px; top:50px; --tint:#3b82f6;">
          <div class="wf-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
          </div>
          <div class="wf-lines"><span class="wf-line l1"></span><span class="wf-line l2"></span></div>
        </div>

        <div class="wf-card" style="left:24px; top:210px; --tint:#f59e0b;">
          <div class="wf-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>
          </div>
          <div class="wf-lines"><span class="wf-line l1"></span><span class="wf-line l2"></span></div>
        </div>

        <div class="wf-card" style="left:364px; top:210px; --tint:#8b5cf6;">
          <div class="wf-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><polyline points="8.5 12.5 11 15 15.5 9.5"></polyline></svg>
          </div>
          <div class="wf-lines"><span class="wf-line l1"></span><span class="wf-line l2"></span></div>
        </div>

        <div class="wf-card" style="left:284px; top:290px; --tint:#14b8a6;">
          <div class="wf-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <div class="wf-lines"><span class="wf-line l1"></span><span class="wf-line l2"></span></div>
        </div>

        <div class="wf-hub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
        </div>

        <span class="wf-badge b-g b-p" style="left:100px; top:50px;"></span>
        <span class="wf-badge b-r" style="left:270px; top:84px;"></span>
        <span class="wf-badge b-g b-p" style="left:420px; top:50px;"></span>
        <span class="wf-badge b-r" style="left:100px; top:210px;"></span>
        <span class="wf-badge b-g b-p" style="left:420px; top:210px;"></span>
        <span class="wf-badge b-g b-p" style="left:260px; top:306px;"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .marketing {
    padding: 5rem 5%;
    background: var(--surface);
    position: relative;
    z-index: 1;
  }

  .marketing-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  .marketing-badge {
    display: inline-block;
    background: var(--ink);
    color: white;
    padding: 0.45rem 1rem;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: 1.5px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .marketing-content h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: -1.5px;
    line-height: 1.2;
  }

  .marketing-content h2 .highlight {
    background: linear-gradient(135deg, #0a84ff, #0071e3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .marketing-text {
    font-size: 1.1rem;
    color: var(--ink-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .marketing-text strong {
    color: var(--ink);
  }

  .marketing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .marketing-item {
    background: white;
    padding: 1.5rem;
    border-radius: 18px;
    border: 1px solid var(--border);
    transition: all 0.4s var(--ease-spring);
    position: relative;
    overflow: hidden;
  }

  .marketing-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--blue), transparent);
    transition: all 0.4s var(--ease-spring);
    transform: translateX(-50%);
  }

  .marketing-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 113, 227, 0.1);
    border-color: rgba(0, 113, 227, 0.2);
  }

  .marketing-item:hover::after {
    width: 60%;
  }

  .marketing-item-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(0, 113, 227, 0.08);
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: all 0.4s var(--ease-spring);
  }

  .marketing-item:hover .marketing-item-icon {
    background: var(--blue);
    color: white;
    transform: scale(1.08);
  }

  .marketing-item h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .marketing-item p {
    font-size: 0.9rem;
    color: var(--ink-secondary);
    line-height: 1.5;
  }

  .btn-marketing {
    display: inline-block;
    background: var(--ink);
    color: white;
    padding: 1rem 2rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s var(--ease-spring);
  }

  .btn-marketing:hover {
    background: #000;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  .marketing-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 460px;
  }

  .workflow-graph {
    position: relative;
    width: min(520px, 100%);
    aspect-ratio: 520 / 420;
  }

  .workflow-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wf-edge {
    stroke: rgba(100, 116, 139, 0.4);
    stroke-width: 2;
    fill: none;
  }

  .wf-pulse {
    fill: #0a84ff;
    filter: drop-shadow(0 0 6px rgba(10, 132, 255, 0.8));
    opacity: 0;
  }

  .p1 { animation: wf-route-1 4s ease-in-out infinite 0s; }
  .p2 { animation: wf-route-2 4s ease-in-out infinite 1s; }
  .p3 { animation: wf-route-3 4s ease-in-out infinite 2s; }
  .p4 { animation: wf-route-4 4s ease-in-out infinite 3s; }

  @keyframes wf-route-1 {
    0%   { opacity: 0; offset-path: path("M100 50 V 40 Q 100 28 112 28 H 408 Q 420 28 420 40 V 50"); offset-distance: 0%; }
    8%   { opacity: 1; }
    42%  { opacity: 1; offset-distance: 100%; }
    50%  { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes wf-route-2 {
    0%   { opacity: 0; offset-path: path("M100 106 V 210"); offset-distance: 0%; }
    8%   { opacity: 1; }
    42%  { opacity: 1; offset-distance: 100%; }
    50%  { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes wf-route-3 {
    0%   { opacity: 0; offset-path: path("M420 106 V 210"); offset-distance: 0%; }
    8%   { opacity: 1; }
    42%  { opacity: 1; offset-distance: 100%; }
    50%  { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes wf-route-4 {
    0%   { opacity: 0; offset-path: path("M260 210 V 306 Q 260 318 272 318 H 284"); offset-distance: 0%; }
    8%   { opacity: 1; }
    42%  { opacity: 1; offset-distance: 100%; }
    50%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* cartes noeuds : icon + lignes squelettes */
  .wf-card {
    position: absolute;
    width: 152px;
    height: 56px;
    background: white;
    border: 1px solid rgba(100, 116, 139, 0.25);
    border-radius: 14px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.8rem;
    z-index: 2;
  }

  .wf-card.hi {
    border-color: #f43f5e;
    box-shadow: 0 4px 20px rgba(244, 63, 94, 0.12);
  }

  .wf-icon {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: color-mix(in srgb, var(--tint) 12%, white);
    color: var(--tint);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wf-lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .wf-line {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: #e2e8f0;
  }

  .wf-line.l1 { width: 100%; }
  .wf-line.l2 { width: 62%; }

  /* hub central en losange */
  .wf-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    transform: rotate(45deg);
    background: linear-gradient(135deg, #4f46e5, #4338ca);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    box-shadow: 0 10px 30px rgba(79, 70, 229, 0.35);
    animation: wf-hub-pulse 2.6s ease-in-out infinite;
  }

  .wf-hub svg {
    transform: rotate(-45deg);
  }

  @keyframes wf-hub-pulse {
    0%, 100% { box-shadow: 0 10px 30px rgba(79, 70, 229, 0.35); }
    50% { box-shadow: 0 10px 40px rgba(79, 70, 229, 0.55); }
  }

  /* badges + / - sur les connexions */
  .wf-badge {
    position: absolute;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    z-index: 4;
  }

  .wf-badge::before,
  .wf-badge::after {
    content: '';
    position: absolute;
    background: white;
  }

  /* minus */
  .wf-badge.b-r {
    background: #ef4444;
    box-shadow: 0 3px 10px rgba(239, 68, 68, 0.4);
  }

  .wf-badge.b-r::before {
    width: 8px;
    height: 1.8px;
    left: 5px;
    top: 8.1px;
  }

  /* plus */
  .wf-badge.b-g {
    background: #10b981;
    box-shadow: 0 3px 10px rgba(16, 185, 129, 0.4);
  }

  .wf-badge.b-g::before {
    width: 8px;
    height: 1.8px;
    left: 5px;
    top: 8.1px;
  }

  .wf-badge.b-g::after {
    width: 1.8px;
    height: 8px;
    left: 8.1px;
    top: 5px;
  }

  @media (max-width: 1024px) {
    .marketing-container { grid-template-columns: 1fr; }
    .marketing-visual { order: -1; min-height: 380px; }
  }

  @media (max-width: 768px) {
    .marketing-grid { grid-template-columns: 1fr; }
    .workflow-graph { width: min(340px, 100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-pulse { animation: none !important; opacity: 0; }
    .wf-hub { animation: none !important; }
  }
</style>