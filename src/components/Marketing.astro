---
import { marketingItems, marketingStats } from '../data/site.js';

const icons = [
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="0.5" fill="currentColor"></circle></svg>',
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>',
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="5" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="M8.3 10.8l7.4-4.6"></path><path d="M8.3 13.2l7.4 4.6"></path></svg>',
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>',
];
---

<section class="marketing" id="marketing">
  <div class="marketing-container">
    <div class="marketing-content" data-reveal="fade">
      <div class="marketing-badge">NOUVEAU</div>
      <h2>Marketing Digital + Automatisation = <span class="highlight">Croissance Illimitée</span></h2>
      <p class="marketing-text">
        Ne vous contentez pas d'automatiser l'existant. Utilisez le marketing digital automatisé pour <strong>attirer continuellement de nouveaux clients</strong>, même pendant que vous dormez.
      </p>
      <div class="marketing-grid">
        {marketingItems.map((item, index) => (
          <div class="marketing-item" data-reveal="fade" style={`--reveal-delay:${index * 80}ms`}>
            <div class="marketing-item-icon" set:html={icons[index]} />
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
      <a href="#contact" class="btn-marketing" data-chat="marketing">Découvrir le Marketing Automatisé →</a>
    </div>

    <div class="marketing-visual" data-reveal="scale" style="--reveal-delay:150ms">
      <div class="workflow-graph">
        <svg class="workflow-edges" viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <path class="wf-edge" d="M95 130 C 140 130, 150 90, 195 90"></path>
          <path class="wf-edge" d="M95 130 C 140 130, 150 200, 195 200"></path>
          <path class="wf-edge" d="M195 90 C 240 90, 250 200, 305 200"></path>
          <path class="wf-edge" d="M195 200 C 240 200, 250 320, 305 320"></path>
          <path class="wf-edge" d="M195 200 C 240 200, 250 90, 305 320"></path>
          <circle class="wf-pulse p1" r="4.5"></circle>
          <circle class="wf-pulse p2" r="4.5"></circle>
          <circle class="wf-pulse p3" r="4.5"></circle>
          <circle class="wf-pulse p4" r="4.5"></circle>
        </svg>

        <div class="wf-node wn-1">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
        </div>
        <div class="wf-node wn-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
        </div>
        <div class="wf-node wn-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="0.5" fill="currentColor"></circle></svg>
        </div>
        <div class="wf-node wn-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
        </div>
        <div class="wf-node wn-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="5" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="M8.3 10.8l7.4-4.6"></path><path d="M8.3 13.2l7.4 4.6"></path></svg>
        </div>
      </div>

      <div class="marketing-stats">
        {marketingStats.map((stat) => (
          <div class="m-stat">
            <div class={`m-stat-icon ${stat.direction}`}>
              {stat.direction === 'up' ? (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
              ) : (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
              )}
            </div>
            <div>
              <div class="m-stat-value">{stat.value}</div>
              <div class="m-stat-label">{stat.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marketing {
    padding: 5rem 5%;
    background: var(--surface);
    position: relative;
    z-index: 1;
  }

  .marketing-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  .marketing-badge {
    display: inline-block;
    background: var(--ink);
    color: white;
    padding: 0.45rem 1rem;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: 1.5px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .marketing-content h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: -1.5px;
    line-height: 1.2;
  }

  .marketing-content h2 .highlight {
    background: linear-gradient(135deg, #0a84ff, #0071e3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .marketing-text {
    font-size: 1.1rem;
    color: var(--ink-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .marketing-text strong {
    color: var(--ink);
  }

  .marketing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .marketing-item {
    background: white;
    padding: 1.5rem;
    border-radius: 18px;
    border: 1px solid var(--border);
    transition: all 0.4s var(--ease-spring);
    position: relative;
    overflow: hidden;
  }

  .marketing-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--blue), transparent);
    transition: all 0.4s var(--ease-spring);
    transform: translateX(-50%);
  }

  .marketing-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 113, 227, 0.1);
    border-color: rgba(0, 113, 227, 0.2);
  }

  .marketing-item:hover::after {
    width: 60%;
  }

  .marketing-item-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(0, 113, 227, 0.08);
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: all 0.4s var(--ease-spring);
  }

  .marketing-item:hover .marketing-item-icon {
    background: var(--blue);
    color: white;
    transform: scale(1.08);
  }

  .marketing-item h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .marketing-item p {
    font-size: 0.9rem;
    color: var(--ink-secondary);
    line-height: 1.5;
  }

  .btn-marketing {
    display: inline-block;
    background: var(--ink);
    color: white;
    padding: 1rem 2rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s var(--ease-spring);
  }

  .btn-marketing:hover {
    background: #000;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  .marketing-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 460px;
  }

  .workflow-graph {
    position: relative;
    width: min(420px, 100%);
    aspect-ratio: 1;
  }

  .workflow-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wf-edge {
    stroke: rgba(0, 113, 227, 0.25);
    stroke-width: 2;
    stroke-dasharray: 5 6;
  }

  .wf-pulse {
    fill: #0a84ff;
    filter: drop-shadow(0 0 6px rgba(10, 132, 255, 0.8));
    opacity: 0;
  }

  .p1 { animation: wf-travel 3.2s linear infinite 0s; }
  .p2 { animation: wf-travel 3.2s linear infinite 0.8s; }
  .p3 { animation: wf-travel 3.2s linear infinite 1.6s; }
  .p4 { animation: wf-travel 3.2s linear infinite 2.4s; }

  @keyframes wf-travel {
    /* chaque pulse parcourt successivement les 3 branches du haut vers le bas */
    0%    { offset-distance: 0%;   opacity: 0; offset-path: path("M95 130 C 140 130, 150 90, 195 90"); }
    12%   { opacity: 1; }
    30%   { opacity: 1; offset-distance: 100%; }
    32%   { opacity: 0; }
    100%  { opacity: 0; offset-distance: 0%; }
  }

  .wf-node {
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: white;
    border: 1.5px solid rgba(0, 113, 227, 0.15);
    box-shadow: 0 8px 24px rgba(0, 113, 227, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
    z-index: 2;
    animation: wf-node-pulse 2.4s ease-in-out infinite;
  }

  .wf-node svg {
    width: 22px;
    height: 22px;
  }

  /* positions des noeuds sur le canvas 400x400 */
  .wn-1 { left: 69px;  top: 104px; }   /* 95,130 */
  .wn-2 { left: 169px; top: 64px; }    /* 195,90 */
  .wn-3 { left: 169px; top: 174px; }   /* 195,200 */
  .wn-4 { left: 279px; top: 174px; }   /* 305,200 */
  .wn-5 { left: 279px; top: 294px; }   /* 305,320 */

  .wn-2 { animation-delay: 0.4s; }
  .wn-3 { animation-delay: 0.8s; }
  .wn-4 { animation-delay: 1.2s; }
  .wn-5 { animation-delay: 1.6s; }

  @keyframes wf-node-pulse {
    0%, 100% { box-shadow: 0 8px 24px rgba(0, 113, 227, 0.1); }
    50% { box-shadow: 0 8px 30px rgba(10, 132, 255, 0.35); }
  }

  .marketing-stats {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .m-stat {
    position: absolute;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    padding: 0.9rem 1.4rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    pointer-events: auto;
    transition: all 0.4s var(--ease-spring);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.07),
      inset 0 0 0 1px rgba(255, 255, 255, 0.3);
    animation: float-gentle 6s ease-in-out infinite;
  }

  .m-stat:hover {
    transform: translateY(-4px) scale(1.04);
    background: rgba(255, 255, 255, 0.92);
  }

  .m-stat:nth-child(1) { top: 6%; right: 2%; animation-delay: 0s; }
  .m-stat:nth-child(2) { top: 42%; left: -2%; animation-delay: 1.2s; }
  .m-stat:nth-child(3) { bottom: 8%; right: 4%; animation-delay: 2.4s; }

  .m-stat-icon {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .m-stat-icon.up { background: rgba(48, 209, 88, 0.12); color: #248a3d; }
  .m-stat-icon.down { background: rgba(0, 113, 227, 0.1); color: var(--blue); }

  .m-stat-value {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: linear-gradient(135deg, #0a84ff, #0071e3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .m-stat-label {
    font-size: 0.78rem;
    color: var(--ink-secondary);
    margin-top: 0.2rem;
  }

  @media (max-width: 1024px) {
    .marketing-container { grid-template-columns: 1fr; }
    .marketing-visual { order: -1; min-height: 380px; }
  }

  @media (max-width: 768px) {
    .marketing-grid { grid-template-columns: 1fr; }
    .workflow-graph { width: min(340px, 100%); }
    .m-stat { padding: 0.7rem 1rem; }
    .m-stat:nth-child(1) { top: 2%; right: 0; }
    .m-stat:nth-child(2) { left: 0; }
    .m-stat:nth-child(3) { bottom: 2%; right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-pulse { animation: none !important; opacity: 0; }
    .wf-node { animation: none !important; }
  }
</style>