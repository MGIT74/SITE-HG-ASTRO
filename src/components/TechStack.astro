---
const techs = [
  { name: 'Astro', category: 'Framework Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/astro/astro-original.svg' },
  { name: 'Vue.js', category: 'Framework Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vuejs/vuejs-original.svg' },
  { name: 'React', category: 'Framework Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg', dark: true },
  { name: 'Next.js', category: 'Framework React', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg' },
  { name: 'Laravel', category: 'Framework Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/laravel/laravel-original.svg' },
  { name: 'Node.js', category: 'Runtime Serveur', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg' },
  { name: 'Python Flask', category: 'API & Microservices', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/flask/flask-original.svg' },
  { name: 'Supabase', category: 'Backend & Auth', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/supabase/supabase-original.svg' },
  { name: 'PostgreSQL', category: 'Base de Données', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg' },
  { name: 'MySQL', category: 'Base de Données', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg' },
  { name: 'MariaDB', category: 'Base de Données', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mariadb/mariadb-original.svg' },
  { name: 'Redis', category: 'Cache & Performance', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/redis/redis-original.svg' },
  { name: 'Cloudflare', category: 'CDN & Sécurité', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cloudflare/cloudflare-original.svg' },
  { name: 'Docker', category: 'Conteneurisation', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg', dark: true },
  { name: 'AWS', category: 'Cloud & Hébergement', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-original-wordmark.svg', dark: true },
  { name: 'Google Cloud', category: 'Cloud & IA', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg', dark: true },
];
---

<section class="tech" id="technologies">
  <div class="section-header" data-reveal="fade">
    <span class="eyebrow">Notre Stack</span>
    <h2>Les Technologies Que Nous Utilisons</h2>
    <p>Nous choisissons des outils modernes, éprouvés et performants pour construire des solutions rapides, fiables et évolutives.</p>
  </div>

  <div class="tech-slider" data-reveal="fade">
    <div class="tech-track" id="tech-track">
      <!-- Deux copies du groupe pour un défilement infini sans saut -->
      {[0, 1].map(() => (
        <div class="tech-group">
          {techs.map((tech) => (
            <div class="tech-card">
              <div class="tech-logo">
                <img src={tech.icon} alt={tech.name} width="40" height="40" loading="lazy" class:list={[{ 'logo-dark': tech.dark }]} />
              </div>
              <div class="tech-info">
                <h4>{tech.name}</h4>
                <span>{tech.category}</span>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech {
    padding: 8rem 5%;
    background: white;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  /* ============ SLIDER INFINI ============ */
  .tech-slider {
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
    /* Fondu sur les bords gauche et droit */
    mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .tech-track {
    display: flex;
    width: max-content;
    animation: tech-scroll 90s linear infinite;
  }

  /* Pause au survol */
  .tech-slider:hover .tech-track {
    animation-play-state: paused;
  }

  @keyframes tech-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .tech-group {
    display: flex;
    gap: 0.85rem;
    padding-right: 0.85rem;
  }

  .tech-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: all 0.35s var(--ease-spring);
    cursor: default;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tech-card:hover {
    background: white;
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 113, 227, 0.25);
  }

  .tech-logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech-logo img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    transition: transform 0.35s var(--ease-spring);
  }

  .tech-logo img.logo-dark {
    filter: brightness(0) saturate(100%) invert(12%) sepia(6%) saturate(8%) hue-rotate(323deg) brightness(94%) contrast(89%);
  }

  .tech-card:hover .tech-logo img {
    transform: scale(1.15);
  }

  .tech-info {
    text-align: left;
  }

  .tech-info h4 {
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 0.1rem;
  }

  .tech-info span {
    font-size: 0.7rem;
    color: var(--ink-tertiary);
  }

  @media (max-width: 768px) {
    .tech {
      padding: 5rem 5%;
    }

    .tech-card {
      padding: 1rem 1.1rem;
      gap: 0.65rem;
    }

    .tech-logo img {
      width: 32px;
      height: 32px;
    }

    .tech-info h4 { font-size: 0.8rem; }
    .tech-info span { font-size: 0.62rem; }
  }
</style>