---
---

<div class="cookie-banner" id="cookie-banner" aria-hidden="true" role="dialog" aria-label="Gestion des cookies">
  <div class="cookie-card">
    <div class="cookie-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c0 1.5 1 2.5 2.5 2.5S17 4 17 5.5 18 8 19.5 8 21 10 21 12z"></path><circle cx="9" cy="10" r="0.8" fill="currentColor"></circle><circle cx="13" cy="14" r="0.8" fill="currentColor"></circle><circle cx="8" cy="15" r="0.8" fill="currentColor"></circle></svg>
    </div>

    <div class="cookie-text">
      <h4>Respect de votre vie privée</h4>
      <p>
        Nous utilisons des cookies pour mesurer l'audience du site et optimiser nos campagnes publicitaires.
        <button class="cookie-more" id="cookie-toggle-details">En savoir plus</button>
      </p>

      <div class="cookie-details" id="cookie-details">
        <label class="cookie-pref">
          <div>
            <strong>Essentiels</strong>
            <span>Nécessaires au fonctionnement du site. Toujours actifs.</span>
          </div>
          <span class="cookie-always">Toujours actif</span>
        </label>
        <label class="cookie-pref">
          <div>
            <strong>Mesure d'audience</strong>
            <span>Statistiques anonymes pour améliorer le site.</span>
          </div>
          <span class="cookie-switch">
            <input type="checkbox" id="cookie-analytics" checked />
            <span class="cookie-slider"></span>
          </span>
        </label>
        <label class="cookie-pref">
          <div>
            <strong>Publicité</strong>
            <span>Personnalisation et mesure de nos campagnes (Google Ads, Meta).</span>
          </div>
          <span class="cookie-switch">
            <input type="checkbox" id="cookie-ads" checked />
            <span class="cookie-slider"></span>
          </span>
        </label>
      </div>
    </div>

    <div class="cookie-actions">
      <button class="cookie-btn cookie-btn-ghost" id="cookie-refuse">Tout refuser</button>
      <button class="cookie-btn cookie-btn-ghost" id="cookie-custom">Personnaliser</button>
      <button class="cookie-btn cookie-btn-primary" id="cookie-accept">Tout accepter</button>
    </div>
    <button class="cookie-btn cookie-btn-primary cookie-save" id="cookie-save" hidden>Valider mes choix</button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const details = document.getElementById('cookie-details');
  const toggleDetails = document.getElementById('cookie-toggle-details');
  const acceptBtn = document.getElementById('cookie-accept');
  const refuseBtn = document.getElementById('cookie-refuse');
  const customBtn = document.getElementById('cookie-custom');
  const saveBtn = document.getElementById('cookie-save');
  const acceptActions = document.querySelector('.cookie-actions');
  let customOpen = false;

  function saveChoice(analytics, ads) {
    localStorage.setItem('hg-cookies', JSON.stringify({ analytics, ads, date: Date.now() }));
  }

  function hideBanner() {
    banner.classList.remove('open');
    banner.setAttribute('aria-hidden', 'true');
    setTimeout(() => (banner.style.display = 'none'), 450);
  }


  if (!localStorage.getItem('hg-cookies')) {
    setTimeout(() => {
      banner.style.display = 'block';
      requestAnimationFrame(() => {
        banner.classList.add('open');
        banner.setAttribute('aria-hidden', 'false');
      });
    }, 800);
  }

  acceptBtn?.addEventListener('click', () => {
    saveChoice(true, true);
    hideBanner();
  });

  refuseBtn?.addEventListener('click', () => {
    saveChoice(false, false);
    hideBanner();
  });

  customBtn?.addEventListener('click', () => {
    customOpen = !customOpen;
    details.classList.toggle('open', customOpen);
    customBtn.textContent = customOpen ? 'Réduire' : 'Personnaliser';
    saveBtn.hidden = !customOpen;
    if (customOpen) {
      acceptActions.style.display = 'none';
    } else {
      acceptActions.style.display = 'flex';
    }
  });

  toggleDetails?.addEventListener('click', () => {
    customOpen = !customOpen;
    details.classList.toggle('open', customOpen);
    customBtn.textContent = customOpen ? 'Réduire' : 'Personnaliser';
    saveBtn.hidden = !customOpen;
    if (customOpen) {
      acceptActions.style.display = 'none';
    } else {
      acceptActions.style.display = 'flex';
    }
  });

  saveBtn?.addEventListener('click', () => {
    saveChoice(
      document.getElementById('cookie-analytics').checked,
      document.getElementById('cookie-ads').checked
    );
    hideBanner();
  });
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%) translateY(120%);
    z-index: 1900;
    width: min(680px, calc(100vw - 2rem));
    opacity: 0;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .cookie-banner.open {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .cookie-card {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 22px;
    padding: 1.5rem 1.75rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .cookie-icon {
    width: 44px;
    height: 44px;
    background: rgba(0, 113, 227, 0.08);
    color: #0071e3;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cookie-text {
    flex: 1;
    min-width: 0;
  }

  .cookie-text h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .cookie-text p {
    font-size: 0.85rem;
    color: #6e6e73;
    line-height: 1.55;
  }

  .cookie-more {
    background: none;
    border: none;
    color: #0071e3;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-details {
    display: none;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .cookie-details.open {
    display: flex;
    animation: cookie-expand 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cookie-expand {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .cookie-pref {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 14px;
    padding: 0.75rem 1rem;
    cursor: pointer;
  }

  .cookie-pref strong {
    display: block;
    font-size: 0.85rem;
  }

  .cookie-pref span:not(.cookie-slider):not(.cookie-always) {
    display: block;
    font-size: 0.75rem;
    color: #86868b;
    margin-top: 0.1rem;
  }

  .cookie-always {
    font-size: 0.7rem;
    font-weight: 600;
    color: #30d158;
    background: rgba(48, 209, 88, 0.1);
    padding: 0.3rem 0.7rem;
    border-radius: 50px;
    white-space: nowrap;
  }

  .cookie-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 26px;
    flex-shrink: 0;
  }

  .cookie-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .cookie-slider {
    position: absolute;
    inset: 0;
    background: #d2d2d7;
    border-radius: 50px;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .cookie-slider::before {
    content: '';
    position: absolute;
    width: 22px;
    height: 22px;
    left: 2px;
    top: 2px;
    background: white;
    border-radius: 50%;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cookie-switch input:checked + .cookie-slider {
    background: #30d158;
  }

  .cookie-switch input:checked + .cookie-slider::before {
    transform: translateX(18px);
  }

  .cookie-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    border: none;
    border-radius: 50px;
    padding: 0.55rem 1.1rem;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cookie-btn-primary {
    background: #1d1d1f;
    color: white;
  }

  .cookie-btn-primary:hover {
    background: #000;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
  }

  .cookie-btn-ghost {
    background: transparent;
    color: #6e6e73;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .cookie-btn-ghost:hover {
    color: #1d1d1f;
    border-color: rgba(0, 0, 0, 0.25);
    transform: translateY(-2px);
  }

  .cookie-save {
    width: 100%;
    margin-top: 0.75rem;
  }

  .cookie-save[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    .cookie-card {
      flex-direction: column;
      padding: 1.25rem;
    }

    .cookie-actions {
      flex-direction: row;
      width: 100%;
    }

    .cookie-btn {
      flex: 1;
      padding: 0.7rem 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>