---
import { footerCols } from '../data/site.js';
---

<footer>
  <div class="footer-grid">
    <div class="footer-col">
      <div class="footer-logo">
        <div class="footer-logo-icon">
          <img src="/logo.svg" alt="Hands Graphic" width="34" height="34" />
        </div>
        <span>Hands Graphic</span>
      </div>
      <p class="footer-desc">
        Agence d'automatisation IA. Nous créons des agents intelligents et des applications métier pour transformer votre entreprise.
      </p>
    </div>
    {footerCols.map((col) => (
      <div class="footer-col">
        <h4>{col.title}</h4>
        <ul>
          {col.links.map((link) => (
            <li><a href="#">{link}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="footer-bottom">
    <p>&copy; 2026 Hands Graphic - Tous droits réservés</p>
    <button class="legal-link" id="legal-open">Mentions légales</button>
  </div>

  <div class="footer-giant" aria-hidden="true">
    <svg
      class="footer-giant-svg"
      viewBox="0 0 1200 142"
      preserveAspectRatio="xMidYMax meet"
      role="presentation"
      focusable="false"
    >
      <defs>
        <linearGradient id="giant-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.07"></stop>
          <stop offset="42%" stop-color="#ffffff" stop-opacity="0.03"></stop>
          <stop offset="72%" stop-color="#ffffff" stop-opacity="0.012"></stop>
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0"></stop>
        </linearGradient>

        <filter id="giant-blur" x="-5%" y="-30%" width="110%" height="160%">
          <feGaussianBlur stdDeviation="6"></feGaussianBlur>
        </filter>

        <linearGradient id="giant-mask-sharp" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fff"></stop>
          <stop offset="52%" stop-color="#fff"></stop>
          <stop offset="96%" stop-color="#000"></stop>
        </linearGradient>
        <linearGradient id="giant-mask-blur" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#000"></stop>
          <stop offset="52%" stop-color="#000"></stop>
          <stop offset="96%" stop-color="#fff"></stop>
        </linearGradient>
        <mask id="giant-sharp-mask">
          <rect x="0" y="0" width="1200" height="142" fill="url(#giant-mask-sharp)"></rect>
        </mask>
        <mask id="giant-blur-mask">
          <rect x="0" y="0" width="1200" height="142" fill="url(#giant-mask-blur)"></rect>
        </mask>
      </defs>

      <text
        x="600"
        y="126"
        text-anchor="middle"
        textLength="1176"
        lengthAdjust="spacingAndGlyphs"
        font-size="128"
        font-weight="800"
        letter-spacing="-3"
        fill="url(#giant-fade)"
        mask="url(#giant-sharp-mask)"
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      >HANDS GRAPHIC</text>
      <text
        x="600"
        y="126"
        text-anchor="middle"
        textLength="1176"
        lengthAdjust="spacingAndGlyphs"
        font-size="128"
        font-weight="800"
        letter-spacing="-3"
        fill="url(#giant-fade)"
        filter="url(#giant-blur)"
        mask="url(#giant-blur-mask)"
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      >HANDS GRAPHIC</text>
    </svg>
  </div>
</footer>

<div class="legal-overlay" id="legal-overlay" aria-hidden="true">
  <div class="legal-modal" role="dialog" aria-modal="true" aria-labelledby="legal-title">
    <button class="legal-close" id="legal-close" aria-label="Fermer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <h3 id="legal-title">Mentions Légales</h3>

    <div class="legal-content">
      <h4>Éditeur du site</h4>
      <p>
        <strong>Hands Graphic</strong><br />
        Expert IA et Consultant Marketing Digital<br />
        <span id="legal-siret">SIRET : à compléter</span><br />
        <span id="legal-address">Adresse : à compléter</span>
      </p>

      <h4>Directeur de la publication</h4>
      <p>Malala — Hands Graphic</p>

      <h4>Hébergement</h4>
      <p>
        Le site est hébergé sur une infrastructure cloud sécurisée.<br />
        Détails de l'hébergeur : à compléter.
      </p>

      <h4>Propriété intellectuelle</h4>
      <p>
        L'ensemble des contenus présents sur ce site (textes, visuels, logos, structure) est la propriété exclusive de Hands Graphic. Toute reproduction, même partielle, est interdite sans autorisation écrite préalable.
      </p>

      <h4>Données personnelles (RGPD)</h4>
      <p>
        Les informations collectées via les formulaires de ce site sont destinées uniquement à Hands Graphic dans le cadre du traitement de votre demande. Elles ne sont jamais cédées à des tiers.
        Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de suppression de vos données en nous contactant.
      </p>

      <h4>Cookies</h4>
      <p>
        Ce site peut utiliser des cookies à des fins de mesure d'audience et d'optimisation des campagnes publicitaires. Vous pouvez configurer votre navigateur pour les refuser.
      </p>

      <h4>Responsabilité</h4>
      <p>
        Hands Graphic s'efforce d'assurer l'exactitude des informations diffusées sur ce site, sans pouvoir garantir l'absence d'erreurs ou d'omissions. Les résultats mentionnés sont donnés à titre indicatif et ne constituent pas une garantie contractuelle.
      </p>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('legal-open');
  const overlay = document.getElementById('legal-overlay');
  const closeBtn = document.getElementById('legal-close');

  function openModal() {
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);


  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });


  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style>
  footer {
    background: var(--ink);
    color: white;
    padding: 4rem 5% 0;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .footer-logo-icon {
    width: 34px;
    height: 34px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    overflow: hidden;
  }

  .footer-logo-icon img {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  .footer-desc {
    color: #86868b;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-col h4 {
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col ul li {
    margin-bottom: 0.75rem;
  }

  .footer-col a {
    color: #a1a1a6;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-col a:hover {
    color: var(--blue-light, #0a84ff);
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #86868b;
    font-size: 0.9rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }

  .footer-giant {
    position: relative;
    z-index: 1;
    margin-top: 1.5rem;
    pointer-events: none;
    user-select: none;
    line-height: 0;
  }

  .footer-giant-svg {
    display: block;
    width: 100%;
    height: auto;
    transform: translateY(6%);
  }

  .legal-link {
    background: none;
    border: none;
    color: #86868b;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    transition: all 0.25s ease;
  }

  .legal-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.08);
  }

  .legal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s;
  }

  .legal-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .legal-modal {
    background: white;
    color: var(--ink);
    border-radius: 24px;
    max-width: 640px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 2.25rem;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.3);
    transform: translateY(24px) scale(0.97);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .legal-overlay.open .legal-modal {
    transform: translateY(0) scale(1);
  }

  .legal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: var(--surface, #f5f5f7);
    color: #6e6e73;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .legal-close:hover {
    background: #1d1d1f;
    color: white;
    transform: rotate(90deg);
  }

  .legal-modal h3 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 1.25rem;
  }

  .legal-content {
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .legal-content h4 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
  }

  .legal-content h4:first-child {
    margin-top: 0;
  }

  .legal-content p {
    font-size: 0.88rem;
    color: #6e6e73;
    line-height: 1.65;
  }

  .legal-content strong {
    color: #1d1d1f;
  }

  @media (max-width: 768px) {
    .legal-modal {
      padding: 1.75rem 1.5rem;
      border-radius: 20px;
    }

    .footer-giant {
      margin-top: 1rem;
    }
  }
</style>