---
const services = [
  { id: 'site', label: 'Site Vitrine' },
  { id: 'agents', label: 'Agents IA' },
  { id: 'marketing', label: 'Marketing Digital' },
  { id: 'automatisation', label: 'Automatisation / Workflows' },
  { id: 'app', label: 'Application Métier' },
  { id: 'autre', label: 'Autre besoin' },
];
---

<!-- ============ BOUTON CHAT FLOTTANT ============ -->
<button class="chat-fab" id="chat-fab" aria-label="Discuter avec nous">
  <span class="chat-fab-status"></span>
  <svg class="chat-fab-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
  <svg class="chat-fab-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
</button>

<!-- ============ POPUP CONTACT ============ -->
<div class="chat-overlay" id="chat-overlay" aria-hidden="true">
  <div class="chat-modal" role="dialog" aria-modal="true" aria-label="Contact">

    <!-- ÉTAPE 1 : QUALIFICATION -->
    <div class="chat-step chat-step-form" id="chat-step-form">
      <button class="chat-modal-close" id="chat-close-form" aria-label="Fermer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="chat-step-badge">Réponse en moins de 2 min</div>
      <h3>Parlons de votre projet</h3>
      <p class="chat-step-sub">Sélectionnez ce qui vous intéresse, notre agent IA vous guide instantanément.</p>

      <form id="chat-lead-form" novalidate>
        <div class="chat-fields">
          <div class="chat-field">
            <input type="text" id="lead-name" placeholder="Votre nom" required autocomplete="name" />
          </div>
          <div class="chat-fields-row">
            <div class="chat-field">
              <input type="email" id="lead-email" placeholder="Votre email *" required autocomplete="email" />
            </div>
            <div class="chat-field">
              <input type="tel" id="lead-phone" placeholder="Téléphone" autocomplete="tel" />
            </div>
          </div>
        </div>

        <div class="chat-services" id="chat-services">
          {services.map((s) => (
            <label class="chat-service-chip">
              <input type="checkbox" value={s.id} />
              <span>{s.label}</span>
            </label>
          ))}
        </div>

        <p class="chat-error" id="chat-form-error" hidden>Merci de renseigner votre nom et un email valide.</p>

        <button type="submit" class="chat-submit">
          Discuter avec notre agent IA
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
        <p class="chat-privacy">Vos données restent confidentielles — jamais partagées.</p>
      </form>
    </div>

    <!-- ÉTAPE 2 : CHAT IA -->
    <div class="chat-step chat-step-chat" id="chat-step-chat" hidden>
      <div class="chat-header">
        <div class="chat-agent">
          <div class="chat-agent-avatar">
            <img src="/logo.svg" alt="Agent IA" width="34" height="34" />
          </div>
          <div class="chat-agent-info">
            <strong>Agent IA Hands Graphic</strong>
            <span><i class="chat-online-dot"></i>En ligne — répond instantanément</span>
          </div>
        </div>
        <button class="chat-modal-close" id="chat-close-chat" aria-label="Fermer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="chat-messages" id="chat-messages"></div>

      <div class="chat-typing" id="chat-typing" hidden>
        <span></span><span></span><span></span>
      </div>

      <form class="chat-input-bar" id="chat-input-form">
        <input type="text" id="chat-input" placeholder="Écrivez votre message..." autocomplete="off" />
        <button type="submit" aria-label="Envoyer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script define:vars={{ }}>
  const WEBHOOK_URL = ''; // URL du webhook n8n à renseigner

  const fab = document.getElementById('chat-fab');
  const overlay = document.getElementById('chat-overlay');
  const stepForm = document.getElementById('chat-step-form');
  const stepChat = document.getElementById('chat-step-chat');
  const leadForm = document.getElementById('chat-lead-form');
  const nameInput = document.getElementById('lead-name');
  const emailInput = document.getElementById('lead-email');
  const phoneInput = document.getElementById('lead-phone');
  const errorEl = document.getElementById('chat-form-error');
  const messagesEl = document.getElementById('chat-messages');
  const typingEl = document.getElementById('chat-typing');
  const inputForm = document.getElementById('chat-input-form');
  const chatInput = document.getElementById('chat-input');

  let lead = { name: '', email: '', phone: '', services: [] };

  function openModal() {
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    fab?.classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(() => (nameInput || chatInput)?.focus(), 350);
  }

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    fab?.classList.remove('open');
    document.body.style.overflow = '';
  }

  fab?.addEventListener('click', () => {
    if (overlay.classList.contains('open')) {
      closeModal();
    } else {
      openModal();
    }
  });

  document.getElementById('chat-close-form')?.addEventListener('click', closeModal);
  document.getElementById('chat-close-chat')?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Validation étape 1
  function isValidEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
  }

  leadForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInput.value.trim();
    const email = emailInput.value.trim();

    if (!name || !isValidEmail(email)) {
      errorEl.hidden = false;
      (!name ? nameInput : emailInput).focus();
      return;
    }
    errorEl.hidden = true;

    lead = {
      name,
      email,
      phone: phoneInput.value.trim(),
      services: Array.from(document.querySelectorAll('#chat-services input:checked')).map((c) => c.value),
    };

    startChat();
  });

  function bubble(text, who) {
    const div = document.createElement('div');
    div.className = 'chat-msg ' + (who === 'user' ? 'chat-msg-user' : 'chat-msg-bot');
    div.textContent = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  let who = 'bot';

  function showTyping(ms) {
    typingEl.hidden = false;
    return new Promise((res) => setTimeout(() => { typingEl.hidden = true; res(); }, ms));
  }

  async function botSay(text, delay) {
    await showTyping(delay || 900);
    who = 'bot';
    bubble(text, 'bot');
    who = 'user';
  }

  async function startChat() {
    stepForm.hidden = true;
    stepChat.hidden = false;

    const firstName = lead.name.split(' ')[0];
    const servicesLabel = lead.services.length
      ? lead.services.join(', ')
      : 'vos besoins';

    const greeting =
      'Bonjour ' + firstName + ' ! 👋 Je suis l\'agent IA de Hands Graphic. ' +
      'Je vois que vous vous intéresse à : ' + servicesLabel() + '. Comment puis-je vous aider ?';

    who = 'user';
    await botSay(greeting, 1100);
    chatInput.focus();
  }

  function servicesLabel() {
    const map = {
      site: 'le Site Vitrine',
      agents: 'les Agents IA',
      marketing: 'le Marketing Digital',
      automatisation: "l'Automatisation",
      app: 'les Applications Métier',
      autre: 'un autre sujet',
    };
    const labels = lead.services.map((s) => map[s] || s);
    if (labels.length === 0) return 'vos besoins';
    if (labels.length === 1) return labels[0];
    return labels.slice(0, -1).join(', ') + ' et ' + labels[labels.length - 1];
  }

  // Envoi message vers n8n
  inputForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = chatInput.value.trim();
    if (!text) return;

    who = 'user';
    bubble(text, 'user');
    chatInput.value = '';

    if (WEBHOOK_URL) {
      try {
        typingEl.hidden = false;
        const res = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lead,
            message: text,
            sessionId: getSessionId(),
          }),
        });
        const data = await res.json();
        typingEl.hidden = true;
        const reply =
          data.reply || data.message || data.output || (Array.isArray(data) && data[0]?.output) || 'Désolé, je n\'ai pas pu traiter votre demande.';
        who = 'bot';
        bubble(reply, 'bot');
        who = 'user';
      } catch (err) {
        typingEl.hidden = true;
        who = 'bot';
        bubble('Oups, une erreur est survenue. Réessayez ou contactez-nous directement.', 'bot');
        who = 'user';
      }
    } else {
      // Démo en attendant le webhook n8n
      await botSay('Je note votre demande : « ' + text + ' ». Un membre de l\'équipe revient vers vous très vite !', 1200);
    }
  });

  function getSessionId() {
    let id = sessionStorage.getItem('hg-chat-session');
    if (!id) {
      id = 'sess-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
      localStorage.setItem('hg-chat-session', id);
    }
    return id;
  }
</script>

<style>
  /* ============ BOUTON FLOTTANT ============ */
  .chat-fab {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    background: linear-gradient(135deg, #0a84ff, #0071e3);
    color: white;
    cursor: pointer;
    z-index: 1501;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 6px 24px rgba(0, 113, 227, 0.4),
      inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-fab:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow:
      0 10px 32px rgba(0, 113, 227, 0.5),
      inset 0 0 0 1px rgba(255, 255, 255, 0.3);
  }

  .chat-fab-status {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 12px;
    height: 12px;
    background: #30d158;
    border: 2.5px solid white;
    border-radius: 50%;
    animation: fab-pulse 2s ease-in-out infinite;
  }

  @keyframes fab-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .chat-fab-icon {
    position: absolute;
    transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-fab-close {
    position: absolute;
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
    transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-fab.open .chat-fab-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .chat-fab.open .chat-fab-close {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  /* ============ POPUP ============ */
  .chat-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 2001;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }

  .chat-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .chat-modal {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 26px;
    width: min(460px, calc(100vw - 2rem));
    max-height: min(680px, calc(100vh - 2rem));
    display: flex;
    flex-direction: column;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    transform: translateY(28px) scale(0.96);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chat-overlay.open .chat-modal {
    transform: translateY(0) scale(1);
  }

  .chat-modal-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.06);
    color: #6e6e73;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-modal-close:hover {
    background: #1d1d1f;
    color: white;
    transform: rotate(90deg);
  }

  /* ============ ÉTAPE 1 : FORMULAIRE ============ */
  .chat-step-form {
    padding: 2rem 1.75rem 1.5rem;
    position: relative;
  }

  .chat-step-form .chat-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
  }

  .chat-step-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(48, 209, 88, 0.12);
    color: #248a3d;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    margin-bottom: 1rem;
  }

  .chat-step-badge::before {
    content: '';
    width: 7px;
    height: 7px;
    background: #30d158;
    border-radius: 50%;
    animation: fab-pulse 2s ease-in-out infinite;
  }

  .chat-step-form h3 {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 0.4rem;
  }

  .chat-step-sub {
    font-size: 0.87rem;
    color: #6e6e73;
    line-height: 1.5;
    margin-bottom: 1.4rem;
  }

  .chat-fields {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
  }

  .chat-fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .chat-field input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.7);
    font-family: inherit;
    font-size: 0.9rem;
    color: #1d1d1f;
    outline: none;
    transition: all 0.25s ease;
  }

  .chat-field input:focus {
    border-color: #0071e3;
    background: white;
    box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.1);
  }

  .chat-field input::placeholder {
    color: #a1a1a6;
  }

  .chat-services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .chat-service-chip {
    cursor: pointer;
  }

  .chat-service-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chat-service-chip span {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 50px;
    background: rgba(0, 0, 0, 0.045);
    border: 1.5px solid transparent;
    font-size: 0.8rem;
    font-weight: 500;
    color: #3a3a3c;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-service-chip:hover span {
    background: rgba(0, 113, 227, 0.06);
  }

  .chat-service-chip input:checked + span {
    background: #0071e3;
    color: white;
    border-color: #0071e3;
    box-shadow: 0 3px 10px rgba(0, 113, 227, 0.3);
  }

  .chat-error {
    font-size: 0.8rem;
    color: #ff3b30;
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .chat-submit {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    border: none;
    border-radius: 50px;
    background: #1d1d1f;
    color: white;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-submit:hover {
    background: #000;
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.25);
  }

  .chat-privacy {
    text-align: center;
    font-size: 0.7rem;
    color: #a1a1a6;
    margin-top: 0.85rem;
  }

  /* ============ ÉTAPE 2 : CHAT ============ */
  .chat-step-chat {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .chat-step-chat[hidden] {
    display: none;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.55);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    flex-shrink: 0;
  }

  .chat-agent {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chat-agent-avatar {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #1d1d1f;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .chat-agent-avatar img {
    width: 68%;
    height: 68%;
    object-fit: contain;
  }

  .chat-agent-info strong {
    display: block;
    font-size: 0.9rem;
  }

  .chat-agent-info span {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: #30d158;
    font-weight: 600;
  }

  .chat-online-dot {
    width: 7px;
    height: 7px;
    background: #30d158;
    border-radius: 50%;
    animation: fab-pulse 2s ease-in-out infinite;
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 260px;
  }

  .chat-msg {
    max-width: 78%;
    padding: 0.7rem 1rem;
    border-radius: 18px;
    font-size: 0.87rem;
    line-height: 1.5;
    animation: msg-in 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    word-wrap: break-word;
  }

  @keyframes msg-in {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .chat-msg-bot {
    background: rgba(0, 0, 0, 0.055);
    color: #1d1d1f;
    align-self: flex-start;
    border-bottom-left-radius: 6px;
  }

  .chat-msg-user {
    background: linear-gradient(135deg, #0a84ff, #0071e3);
    color: white;
    align-self: flex-end;
    border-bottom-right-radius: 6px;
    box-shadow: 0 3px 12px rgba(0, 113, 227, 0.25);
  }

  .chat-typing {
    display: flex;
    gap: 4px;
    padding: 0.75rem 1.25rem;
  }

  .chat-typing[hidden] {
    display: none;
  }

  .chat-typing span {
    width: 7px;
    height: 7px;
    background: #a1a1a6;
    border-radius: 50%;
    animation: typing-bounce 1.2s ease-in-out infinite;
  }

  .chat-typing span:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  .chat-input-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: rgba(255, 255, 255, 0.55);
    flex-shrink: 0;
  }

  .chat-input-bar input {
    flex: 1;
    padding: 0.7rem 1.1rem;
    border: 1.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 50px;
    background: white;
    font-family: inherit;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.25s ease;
  }

  .chat-input-bar input:focus {
    border-color: #0071e3;
  }

  .chat-input-bar button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: #0071e3;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-input-bar button:hover {
    background: #0058b9;
    transform: scale(1.08);
  }

  @media (max-width: 768px) {
    .chat-modal {
      border-radius: 22px;
      max-height: calc(100vh - 2rem);
    }

    .chat-fields-row {
      grid-template-columns: 1fr;
