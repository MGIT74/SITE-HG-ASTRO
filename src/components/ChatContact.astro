---
const services = [
  { id: 'site', label: 'Site Vitrine' },
  { id: 'agents', label: 'Agents IA' },
  { id: 'marketing', label: 'Marketing Digital' },
  { id: 'automatisation', label: 'Automatisation / Workflows' },
  { id: 'app', label: 'Application Métier' },
  { id: 'autre', label: 'Autre besoin' },
];
---

<!-- ============ BOUTON CHAT FLOTTANT ============ -->
<button class="chat-fab" id="chat-fab" aria-label="Discuter avec nous">
  <span class="chat-fab-status"></span>
  <svg class="chat-fab-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
  <svg class="chat-fab-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
</button>

<!-- ============ POPUP CONTACT CONTEXTUEL ============ -->
<div class="chat-overlay" id="chat-overlay" aria-hidden="true">
  <div class="chat-modal" role="dialog" aria-modal="true" aria-label="Contact">

    <!-- ÉTAPE 1 : COORDONNÉES -->
    <div class="chat-step chat-step-form" id="chat-step-form">
      <button class="chat-modal-close" id="chat-close-form" aria-label="Fermer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="chat-step-badge">Réponse en moins de 2 min</div>
      <h3 id="chat-form-title">Parlons de votre projet</h3>
      <p class="chat-context" id="chat-context" hidden></p>
      <p class="chat-step-sub">Choisissez votre mode de contact préféré :</p>

      <form id="chat-lead-form" novalidate>
        <div class="chat-fields">
          <div class="chat-field">
            <input type="text" id="lead-name" placeholder="Votre nom" required autocomplete="name" />
          </div>
          <div class="chat-fields-row">
            <div class="chat-field">
              <input type="email" id="lead-email" placeholder="Votre email *" required autocomplete="email" />
            </div>
            <div class="chat-field">
              <input type="tel" id="lead-phone" placeholder="Téléphone" autocomplete="tel" />
            </div>
          </div>
        </div>

        <div class="chat-services" id="chat-services">
          {services.map((s) => (
            <label class="chat-service-chip">
              <input type="checkbox" value={s.id} />
              <span>{s.label}</span>
            </label>
          ))}
        </div>

        <p class="chat-error" id="chat-form-error" hidden>Merci de renseigner votre nom et un email valide.</p>

        <div class="chat-mode-choice">
          <button type="submit" class="chat-mode-btn chat-mode-vocal" data-mode="vocal">
            <span class="chat-mode-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
            </span>
            <span class="chat-mode-label">
              <strong>Discuter avec l'IA</strong>
              <small>Vocal ou texte — réponse instantanée</small>
            </span>
          </button>
          <button type="button" class="chat-mode-btn chat-mode-form" id="chat-mode-form-btn">
            <span class="chat-mode-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <span class="chat-mode-label">
              <strong>Demande de devis</strong>
              <small>Formulaire + message détaillé</small>
            </span>
          </button>
        </div>
        <p class="chat-privacy">Vos données restent confidentielles — jamais partagées.</p>
      </form>

      <!-- Formulaire devis détaillé (mode 2) -->
      <div class="chat-quote-form" id="chat-quote-form" hidden>
        <div class="chat-field">
          <textarea id="quote-message" rows="4" placeholder="Décrivez votre projet en quelques lignes..."></textarea>
        </div>
        <p class="chat-error" id="quote-error" hidden>Merci de décrire votre projet (10 caractères minimum).</p>
        <button class="chat-submit" id="quote-submit">
          Envoyer ma demande
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
        <button type="button" class="chat-back-link" id="chat-back-to-modes">← Retour</button>
      </div>
    </div>

    <!-- ÉTAPE 2 : CHAT IA (vocal + texte) -->
    <div class="chat-step chat-step-chat" id="chat-step-chat" hidden>
      <div class="chat-header">
        <div class="chat-agent">
          <div class="chat-agent-avatar">
            <img src="/logo.svg" alt="Agent IA" width="34" height="34" />
          </div>
          <div class="chat-agent-info">
            <strong>Agent IA Hands Graphic</strong>
            <span><i class="chat-online-dot"></i>En ligne — <em id="chat-mode-label">vocal</em></span>
          </div>
        </div>
        <div class="chat-header-actions">
          <button class="chat-sound-toggle" id="chat-sound-toggle" aria-label="Activer/désactiver la voix" title="Voix ElevenLabs">
            <svg class="snd-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
            <svg class="chat-sound-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
          </button>
          <button class="chat-modal-close" id="chat-close-chat" aria-label="Fermer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </div>

      <div class="chat-messages" id="chat-messages"></div>

      <div class="chat-voice-orb" id="chat-voice-orb" hidden>
        <div class="voice-orb-core"></div>
        <span class="voice-orb-hint">Appuyez pour parler</span>
      </div>

      <div class="chat-typing" id="chat-typing" hidden>
        <span></span><span></span><span></span>
      </div>

      <div class="chat-input-bar" id="chat-input-bar">
        <button class="chat-mic" id="chat-mic" aria-label="Parler" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="12" y2="23" style="display:none"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
        </button>
        <input type="text" id="chat-input" placeholder="Écrivez ou appuyez sur le micro..." autocomplete="off" />
        <button class="chat-send" id="chat-send" aria-label="Envoyer" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ }}>
  const WEBHOOK_URL = ''; // URL du webhook n8n à renseigner

  const fab = document.getElementById('chat-fab');
  const overlay = document.getElementById('chat-overlay');
  const stepForm = document.getElementById('chat-step-form');
  const stepChat = document.getElementById('chat-step-chat');
  const leadForm = document.getElementById('chat-lead-form');
  const quoteForm = document.getElementById('chat-quote-form');
  const nameInput = document.getElementById('lead-name');
  const emailInput = document.getElementById('lead-email');
  const phoneInput = document.getElementById('lead-phone');
  const errorEl = document.getElementById('chat-form-error');
  const contextEl = document.getElementById('chat-context');
  const titleEl = document.getElementById('chat-form-title');
  const messagesEl = document.getElementById('chat-messages');
  const typingEl = document.getElementById('chat-typing');
  const chatInput = document.getElementById('chat-input');
  const micBtn = document.getElementById('chat-mic');
  const soundToggle = document.getElementById('chat-sound-toggle');
  const voiceOrb = document.getElementById('chat-voice-orb');

  let lead = { name: '', email: '', phone: '', services: [] };
  let soundEnabled = true;
  let voiceMode = true;
  let recognition = null;
  let isRecording = false;

  // ============ CONTEXTE DYNAMIQUE PAR BOUTON ============
  const CHAT_CONTEXTS = {
    site: { services: ['site'], label: 'le Site Vitrine' },
    agents: { services: ['agents'], label: 'les Agents IA' },
    marketing: { services: ['marketing'], label: 'le Marketing Digital' },
    automatisation: { services: ['automatisation'], label: "l'Automatisation" },
    app: { services: ['app'], label: 'les Applications Métier' },
    geo: { services: ['marketing'], label: 'être cité par les IA' },
    demo: { services: [], label: null },
    generic: { services: [], label: null },
  };

  let currentContext = 'generic';

  function applyContext(key, serviceLabel) {
    const ctx = CHAT_CONTEXTS[key] || CHAT_CONTEXTS.generic;
    currentContext = key;

    const checkboxes = document.querySelectorAll('#chat-services input');
    let matched = false;

    checkboxes.forEach((c) => {
      let shouldCheck = ctx.services.includes(c.value);

      // Contexte pricing : match par nom de plan
      if (key === 'pricing' && serviceLabel) {
        const s = serviceLabel.toLowerCase();
        if (s.includes('site')) shouldCheck = c.value === 'site';
        else if (s.includes('marketing')) shouldCheck = c.value === 'marketing';
        else if (s.includes('essential') || s.includes('business') || s.includes('enterprise')) shouldCheck = c.value === 'automatisation';
        if (shouldCheck) matched = true;
      }
      c.checked = shouldCheck;
    });

    if (ctx.label) {
      contextEl.textContent = 'Vous êtes intéressé par : ' + ctx.label;
      contextEl.hidden = false;
    } else if (key === 'pricing' && serviceLabel) {
      contextEl.textContent = 'Vous êtes intéressé par : ' + serviceLabel;
      contextEl.hidden = false;
    } else {
      contextEl.hidden = true;
    }
  }

  // Intercepte tous les CTA avec data-chat
  document.querySelectorAll('[data-chat]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      applyContext(btn.getAttribute('data-chat'), btn.getAttribute('data-service'));
      openModal();
    });
  });

  function openModal() {
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    fab?.classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(() => nameInput?.focus(), 350);
  }

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    fab?.classList.remove('open');
    document.body.style.overflow = '';
    stopRecording();
    stopSpeaking();
  }

  fab?.addEventListener('click', () => {
    if (overlay.classList.contains('open')) {
      closeModal();
    } else {
      applyContext(currentContext);
      openModal();
    }
  });

  document.getElementById('chat-close-form')?.addEventListener('click', closeModal);
  document.getElementById('chat-close-chat')?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  function isValidEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
  }

  function collectLead() {
    const name = nameInput.value.trim();
    const email = emailInput.value.trim();

    if (!name || !isValidEmail(email)) {
      errorEl.hidden = false;
      (!name ? nameInput : emailInput).focus();
      return null;
    }
    errorEl.hidden = true;

    return {
      name,
      email,
      phone: phoneInput.value.trim(),
      services: Array.from(document.querySelectorAll('#chat-services input:checked')).map((c) => c.value),
      context: currentContext,
    };
  }

  function servicesLabel() {
    const map = {
      site: 'le Site Vitrine',
      agents: 'les Agents IA',
      marketing: 'le Marketing Digital',
      automatisation: "l'Automatisation",
      app: 'les Applications Métier',
      autre: 'un autre sujet',
    };
    const labels = lead.services.map((s) => map[s] || s);
    if (labels.length === 0) return 'vos besoins';
    if (labels.length === 1) return labels[0];
    return labels.slice(0, -1).join(', ') + ' et ' + labels[labels.length - 1];
  }

  function bubble(text, who) {
    const div = document.createElement('div');
    div.className = 'chat-msg ' + (who === 'user' ? 'chat-msg-user' : 'chat-msg-bot');
    div.textContent = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  }

  async function speak(text) {
    if (!soundEnabled || !WEBHOOK_URL) return;
    try {
      const res = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'tts', text, sessionId: getSessionId() }),
      });
      if (!res.ok) return;
      const blob = await res.blob();
      if (!blob.type.includes('audio')) return;
      const audio = new Audio(URL.createObjectURL(blob));
      audio.play();
    } catch (e) {}
  }

  let activeAudio = null;
  function stopSpeaking() {
    if (activeAudio) {
      activeAudio.pause();
      activeAudio = null;
    }
  }

  async function sendToAgent(text) {
    if (!WEBHOOK_URL) {
      await showTyping(1200);
      bubble('Parfait, je note : « ' + text + ' ». Le mode IA connecté sera actif dès que le webhook n8n sera branché !', 'bot');
      return;
    }

    typingEl.hidden = false;
    try {
      const res = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lead,
          message: text,
          sessionId: getSessionId(),
        }),
      });
      const data = await res.json();
      typingEl.hidden = true;
      const reply =
        data.reply || data.message || data.output || (Array.isArray(data) && data[0]?.output) || 'Désolé, je n\'ai pas pu traiter votre demande.';

      bubble(reply, 'bot');
      activeAudio = await speak(reply);
    } catch (err) {
      typingEl.hidden = true;
      bubble('Oups, une erreur est survenue. Réessayez dans un instant.', 'bot');
    }
  }

  function showTyping(ms) {
    typingEl.hidden = false;
    return new Promise((res) => setTimeout(() => { typingEl.hidden = true; res(); }, ms));
  }

  // ============ MODE VOCAL (Web Speech API) ============
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

  function startRecording() {
    if (!SpeechRecognition) {
      bubble('La dictée vocale n\'est pas supportée par ce navigateur. Écrivez votre message !', 'bot');
      return;
    }

    recognition = new SpeechRecognition();
    recognition.lang = 'fr-FR';
    recognition.continuous = false;
    recognition.interimResults = true;

    isRecording = true;
    micBtn.classList.add('recording');
    voiceOrb.hidden = false;

    recognition.onresult = (event) => {
      let transcript = '';
      for (let i = 0; i < event.results.length; i++) {
        transcript += event.results[i][0].transcript;
      }
      chatInput.value = transcript;
    };

    recognition.onend = () => {
      isRecording = false;
      micBtn.classList.remove('recording');
      voiceOrb.hidden = true;
      const text = chatInput.value.trim();
      if (text) {
        chatInput.value = '';
        sendUserMessage(text);
      }
    };

    recognition.onerror = () => {
      isRecording = false;
      micBtn.classList.remove('recording');
      voiceOrb.hidden = true;
    };

    recognition.start();
  }

  function stopRecording() {
    if (recognition && isRecording) {
      recognition.stop();
      isRecording = false;
      micBtn?.classList.remove('recording');
      if (voiceOrb) voiceOrb.hidden = true;
    }
  }

  micBtn?.addEventListener('click', () => {
    if (isRecording) {
      stopRecording();
    } else {
      startRecording();
    }
  });

  // ============ ENVOI ============
  async function sendUserMessage(text) {
    bubble(text, 'user');

    if (!WEBHOOK_URL) {
      await showTyping(1200);
      bubble('Je note votre demande : « ' + text + ' ». Le webhook n8n sera connecté très bientôt !', 'bot');
      return;
    }

    typingEl.hidden = false;
    try {
      const res = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lead, message: text, sessionId: getSessionId() }),
      });
      const data = await res.json();
      typingEl.hidden = true;
      const reply =
        data.reply || data.message || data.output || (Array.isArray(data) && data[0]?.output) || 'Désolé, je n\'ai pas pu traiter votre demande.';

      bubble(reply, 'bot');
      speak(reply);
    } catch (err) {
      typingEl.hidden = true;
      bubble('Oups, une erreur est survenue. Réessayez dans un instant.', 'bot');
    }
  }

  document.getElementById('chat-send')?.addEventListener('click', () => {
    const text = chatInput.value.trim();
    if (!text) return;
    chatInput.value = '';
    stopSpeaking();
    sendUserMessage(text);
  });

  chatInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      const text = chatInput.value.trim();
      if (!text) return;
      chatInput.value = '';
      stopSpeaking();
      sendUserMessage(text);
    }
  });

  soundToggle?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    soundToggle.classList.toggle('muted', !soundEnabled);
    if (!soundEnabled) stopSpeaking();
  });

  // ============ DÉMARRAGE DU CHAT ============
  async function startChat() {
    stepForm.hidden = true;
    stepChat.hidden = false;

    const firstName = lead.name.split(' ')[0];
    const greeting =
      'Bonjour ' + firstName + ' ! 👋 Je suis l\'agent IA de Hands Graphic. Je vois que vous vous intéressez à ' +
      servicesLabel() + '. Comment puis-je vous aider ? Vous pouvez me parler au micro ou écrire.';

    bubble(greeting, 'bot');
    speak(greeting.replace(/👋 /g, ''));
    chatInput.focus();
  }

  leadForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const collected = collectLead();
    if (!collected) return;
    lead = collected;
    startChat();
  });

  // ============ MODE DEVIS (formulaire avec message) ============
  document.getElementById('chat-mode-form-btn')?.addEventListener('click', () => {
    leadForm.hidden = true;
    document.getElementById('chat-mode-form-btn').closest('.chat-mode-choice').style.display = 'none';
    document.querySelector('.chat-step-form h3').textContent = 'Votre demande de devis';
    quoteForm.hidden = false;
  });

  document.getElementById('chat-back-to-modes')?.addEventListener('click', () => {
    quoteForm.hidden = true;
    leadForm.hidden = false;
    document.querySelector('.chat-mode-choice').style.display = 'flex';
    titleEl.textContent = 'Parlons de votre projet';
  });

  document.getElementById('quote-submit')?.addEventListener('click', () => {
    const message = document.getElementById('quote-message').value.trim();
    const errorEl2 = document.getElementById('quote-error');

    if (!message || message.length < 10) {
      errorEl2.hidden = false;
      return;
    }
    errorEl2.hidden = true;

    const collected = collectLead();
    if (!collected) {
      quoteForm.hidden = true;
      leadForm.hidden = false;
      document.querySelector('.chat-mode-choice').style.display = 'flex';
      quoteForm.hidden = true;
      return;
    }
    lead = { ...collected, message };

    if (WEBHOOK_URL) {
      fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'quote', lead, sessionId: getSessionId() }),
      }).catch(() => {});
    }

    titleEl.textContent = 'Demande envoyée !';
    quoteForm.innerHTML =
      '<div class="quote-success"><div class="quote-success-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div><h4>Merci ' + lead.name.split(' ')[0] + ' !</h4><p>Votre demande a bien été reçue. Nous revenons vers vous sous 24h ouvrées.</p></div>';
  });

  function getSessionId() {
    let id = localStorage.getItem('hg-chat-session');
    if (!id) {
      id = 'sess-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
      localStorage.setItem('hg-chat-session', id);
    }
    return id;
  }
</script>

<style>
  /* ============ BOUTON FLOTTANT ============ */
  .chat-fab {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    background: linear-gradient(135deg, #0a84ff, #0071e3);
    color: white;
    cursor: pointer;
    z-index: 1501;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 6px 24px rgba(0, 113, 227, 0.4),
      inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .chat-fab:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow:
      0 10px 32px rgba(0, 113, 227, 0.5),
      inset 0 0 0 1px rgba(255, 255, 255, 0.3);
  }

  .chat-fab-status {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 12px;
    height: 12px;
    background: #30d158;
    border: 2.5px solid white;
    border-radius: 50%;
    animation: fab-pulse 2s ease-in-out infinite;
  }

  @keyframes fab-pulse {
